# Consumed by Cloudflare (not served); index.html mirrors the CSP as a meta tag
# so local previews get it too (`python3 -m http.server`, file://), and
# validate-site.js holds the two in sync. Never set a header on
# /* that another matching rule also sets — values from all matching rules join.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' https://*.googletagmanager.com https://*.google-analytics.com https://img.youtube.com https://speakerd.s3.amazonaws.com; connect-src 'self' https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.googletagmanager.com https://stats.g.doubleclick.net https://www.google.com https://cloudflareinsights.com https://api.github.com https://api.stackexchange.com; frame-src https://*.googletagmanager.com https://www.youtube-nocookie.com https://speakerdeck.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Without these rules everything is served max-age=0 and revalidated on every
# page view. URLs are unversioned, so code TTLs stay short (changes converge
# within the hour); images and icons change rarely and can wait a month —
# renaming the file busts it early.
/static/css/*
  Cache-Control: public, max-age=3600

/static/js/*
  Cache-Control: public, max-age=3600

/static/image/*
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

# Homepage-only preload hints: Cloudflare turns these into 103 Early Hints when
# that zone setting is on, and browsers honor them from the response headers
# either way — both start the fetch before HTML parsing.
#
# Vary: Accept because / has two representations: src/worker.mjs answers
# Accept: text/markdown with /index.md and every other request with this HTML.
# The Worker sets the same header on the responses it builds, but not on the
# ones it must hand back untouched — a 304 has no body to re-wrap — and those
# come from the asset router, which is exactly what applies this file. Keeping
# it here also means / keeps varying if the Worker is ever rolled back. It is
# the only Vary in the file, so nothing joins with it, and the Worker appends to
# an existing value rather than repeating it.
/
  Link: </static/css/home.css>; rel=preload; as=style
  Link: </static/image/avatar.webp>; rel=preload; as=image
  Link: </.well-known/api-catalog>; rel="api-catalog"
  Vary: Accept

# Talk data and its OpenAPI description change about as often as the talks do,
# so they get the same one-hour TTL as the other unversioned code assets.
/api/*
  Cache-Control: public, max-age=3600

# Media types for the RFC 9727 catalog and the description it points at.
# Unlike two _headers rules setting one header, an explicit Content-Type
# replaces the type Cloudflare infers from the file extension instead of
# joining with it (checked against `wrangler dev`) — which is what lets the
# extensionless well-known URI be served as a linkset at all. The profile
# parameter is the RFC's own SHOULD: it marks this linkset as an API catalog
# rather than just any link set.
/.well-known/api-catalog
  Content-Type: application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"

/api/openapi.json
  Content-Type: application/openapi+json;version=3.1

# ARD manifest, dual-published at both well-known paths. Access-Control-Allow-
# Origin is what the scanner's SKILL.md asks for: the server-side scan does not
# need it, but a browser-based agent reading the manifest from another origin
# does. No Content-Type rule here — unlike the extensionless api-catalog above,
# these end in .json and Cloudflare infers application/json from the extension.
# Exact paths, no globs: /* also matches them, so this file may only add a
# header /* does not already set, or the two values would comma-join.
/.well-known/ai-catalog.json
  Access-Control-Allow-Origin: *

/.well-known/ard.json
  Access-Control-Allow-Origin: *

# MCP server card, published at three paths. /mcp/server-card is the location
# SEP-2127 reserves (<streamable-http-url>/server-card); the two .well-known
# copies are what today's scanners probe, and SEP-2127 explicitly declined to
# put the card there. Byte-identical, with validate-site.js keeping them so.
#
# The canonical path has no extension, so Cloudflare infers no type at all —
# measured under `wrangler dev`, the response arrives with no Content-Type
# whatsoever. That makes this rule load-bearing rather than cosmetic, and it
# fails open (no type) rather than closed. Access-Control-Allow-Origin is a
# MUST for hosted card endpoints, so browser agents can read them cross-origin.
# Exact paths, no globs: /* also matches these, so these rules may only add
# headers /* does not already set, or the two values would comma-join.
/mcp/server-card
  Content-Type: application/mcp-server-card+json
  Access-Control-Allow-Origin: *

/.well-known/mcp/server-card.json
  Content-Type: application/mcp-server-card+json
  Access-Control-Allow-Origin: *

/.well-known/mcp.json
  Content-Type: application/mcp-server-card+json
  Access-Control-Allow-Origin: *
