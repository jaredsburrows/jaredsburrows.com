{
  // Static site plus one route of server code. Cloudflare serves the files in
  // this directory from its edge; src/worker.mjs runs on "/" and only "/"
  // (assets.run_worker_first), where it answers Accept: text/markdown with the
  // markdown twin of the homepage. Every other path is matched by the asset
  // router before any code runs, so those requests stay unbilled — the Worker
  // is invoked, and billed, only for the homepage.
  "name": "jaredsburrows-com",
  "account_id": "23fd1f78e6c723b48b52bd073092907a",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "main": "src/worker.mjs",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    // Exposes the asset router to the Worker as env.ASSETS.fetch(), which is how
    // the Worker reads /index.md and how everything it does not negotiate is
    // served: without this the script has no way to reach the files at all.
    "binding": "ASSETS",
    // Exactly one route-first pattern. Broadening this (or setting it to true)
    // would put every request for every asset through a billed invocation.
    "run_worker_first": ["/"]
  },
  // Observability on, as #139 set it. Both switches have to say so: wrangler's
  // normalizeObservability only fills fields that are `undefined` and the deploy
  // payload carries this block verbatim, so a nested "logs.enabled" that
  // disagrees with the "enabled" above it ships silently for a Worker (for
  // containers wrangler rejects the same mismatch outright — '"enabled" and
  // "logs.enabled" cannot be set to different values'). Leaving the two at odds
  // is the bug, in whichever direction; they agree here.
  //
  // What changed under this setting: #139 turned it on while this was an
  // assets-only Worker with no "main", so there were no invocations to log and
  // the Observability view could only stay empty — it was ready for a script
  // that did not exist. This PR is that script. From here / is an invocation,
  // so Workers Logs holds a record of every homepage request, sampled at 1,
  // for as long as the plan retains it and readable by anyone with dashboard
  // access. That is now a live data-collection choice rather than a dormant
  // one; set both switches to false if the record is not wanted.
  //
  // redact_query_string keeps the logged URL down to its path. It defaults to
  // false — the full request URL — and / is the one path this site publishes
  // everywhere, so it collects whatever utm_*, click ID or referrer junk gets
  // appended to a link to the homepage.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
