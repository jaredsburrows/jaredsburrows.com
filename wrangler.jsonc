{
  // Assets-only Worker: no server code, Cloudflare just serves the files in
  // this directory from its edge. Requests to static assets are not billed
  // as Worker invocations.
  "name": "jaredsburrows-com",
  "account_id": "23fd1f78e6c723b48b52bd073092907a",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
